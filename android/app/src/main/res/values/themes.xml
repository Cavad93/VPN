<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CavadVPN" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary branding -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/bg_primary</item>
        <item name="colorOnPrimary">@color/btn_text_dark</item>

        <!-- Secondary branding -->
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_cyan_dim</item>
        <item name="colorOnSecondary">@color/btn_text_dark</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text input styling -->
        <item name="textInputStyle">@style/Widget.CavadVPN.TextInputLayout</item>

        <!-- Default text color -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- Outlined text fields with cyan accent -->
    <style name="Widget.CavadVPN.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent_cyan</item>
        <item name="hintTextColor">@color/accent_cyan</item>
        <item name="boxBackgroundColor">@color/bg_card</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Large power button style -->
    <style name="Widget.CavadVPN.PowerButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">100dp</item>
        <item name="android:minWidth">160dp</item>
        <item name="android:minHeight">160dp</item>
        <item name="android:textSize">0sp</item>
        <item name="iconSize">64dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="iconTint">@color/accent_cyan</item>
        <item name="rippleColor">@color/accent_cyan_dim</item>
    </style>

    <!-- Stat card style -->
    <style name="Widget.CavadVPN.StatCard">
        <item name="android:background">@drawable/bg_card_rounded</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Bottom icon button -->
    <style name="Widget.CavadVPN.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="rippleColor">@color/accent_cyan_dim</item>
    </style>
</resources>
