#!/bin/bash
# preinstall — CavadVPN macOS client pre-installation checks
# Runs before files are copied. Exit non-zero to abort installation.

set -euo pipefail

INSTALL_DIR="/Applications/CavadVPN"
MIN_MACOS_MAJOR=12   # macOS Monterey

# ── OS version check ────────────────────────────────────────────────────────
os_major=$(sw_vers -productVersion | cut -d. -f1)
if [[ "$os_major" -lt "$MIN_MACOS_MAJOR" ]]; then
    echo "ERROR: CavadVPN requires macOS $MIN_MACOS_MAJOR or later (found $os_major)" >&2
    exit 1
fi

# ── Architecture check ───────────────────────────────────────────────────────
arch=$(uname -m)
if [[ "$arch" != "arm64" && "$arch" != "x86_64" ]]; then
    echo "ERROR: Unsupported architecture: $arch" >&2
    exit 2
fi

# ── Python 3.11+ check ───────────────────────────────────────────────────────
PYTHON=""
for candidate in python3.13 python3.12 python3.11 python3; do
    if command -v "$candidate" &>/dev/null; then
        version=$("$candidate" -c 'import sys; print(sys.version_info[:2])' 2>/dev/null || true)
        # version looks like (3, 11)
        minor=$(echo "$version" | tr -d '(),' | awk '{print $2}')
        if [[ -n "$minor" && "$minor" -ge 11 ]]; then
            PYTHON="$candidate"
            break
        fi
    fi
done

if [[ -z "$PYTHON" ]]; then
    echo "ERROR: Python 3.11 or later is required." >&2
    echo "Install it from https://www.python.org/downloads/ or via Homebrew: brew install python@3.11" >&2
    exit 3
fi

echo "Preinstall checks passed: macOS $os_major, arch=$arch, python=$PYTHON"
exit 0
